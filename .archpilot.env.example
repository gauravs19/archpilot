# Archpilot configuration file
# Copy this to .archpilot.env and fill in your values.
# .archpilot.env is gitignored — never commit credentials.
#
# Environment variables always take priority over values in this file.
# Search order: <project>/.archpilot.env → <project>/archpilot.env → ~/.archpilot.env

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT_KEY=ARCH

# ── Azure DevOps ──────────────────────────────────────────────────────────────
# org slug from: https://dev.azure.com/<ADO_ORG>
ADO_ORG=myorg
ADO_PROJECT=ArchProject
# Generate at: dev.azure.com → User Settings → Personal Access Tokens
# Required scope: Work Items (Read & Write)
ADO_PAT=your_pat_here

# ── Anthropic (pipeline) ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
